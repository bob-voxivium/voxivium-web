# =============================================================================
# Voxivium marketing site — environment variables
# =============================================================================
# Anything prefixed PUBLIC_ is exposed to the browser. Don't put secrets here;
# secrets that end up in import.meta.env get bundled into the client.

# After `terraform apply`, copy the api_endpoint output here. The voter form
# posts to <api_endpoint>/subscribe; the politician/media/AI forms all post
# to <api_endpoint>/contact and discriminate via the form_type body field.
PUBLIC_VOTER_FORM_ENDPOINT=https://your-api-id.execute-api.us-east-1.amazonaws.com/subscribe
PUBLIC_POLITICIAN_FORM_ENDPOINT=https://your-api-id.execute-api.us-east-1.amazonaws.com/contact
PUBLIC_MEDIA_FORM_ENDPOINT=https://your-api-id.execute-api.us-east-1.amazonaws.com/contact
PUBLIC_AI_LAB_FORM_ENDPOINT=https://your-api-id.execute-api.us-east-1.amazonaws.com/contact
PUBLIC_PARTNERSHIP_FORM_ENDPOINT=https://your-api-id.execute-api.us-east-1.amazonaws.com/contact
PUBLIC_CAREERS_FORM_ENDPOINT=https://your-api-id.execute-api.us-east-1.amazonaws.com/contact

# Kickstarter campaign URL. Use "#" while the campaign is still a placeholder.
PUBLIC_KICKSTARTER_URL=#

# Cloudflare Turnstile — public site key is safe to commit; secret lives in SSM.
# This is the live voxivium.com site key.
PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAADMNt6Kfo4pSPYK1

# =============================================================================
# Firebase Web SDK — same Firebase project as the KMP client.
# =============================================================================
# Used to sign voter / future-politician users into off-mobile payment flows
# (/subscribe, account settings). Pull these values from Firebase Console →
# Project Settings → Your apps → Web app. All four are public — the API key
# is a project identifier, not a secret; access control is via Firebase
# Security Rules and the Voxivium backend's session-exchange endpoint.
PUBLIC_FIREBASE_API_KEY=TODO
PUBLIC_FIREBASE_AUTH_DOMAIN=TODO.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=TODO
PUBLIC_FIREBASE_APP_ID=TODO

# =============================================================================
# PayPal Smart Buttons (sandbox or live).
# =============================================================================
# Only the public client-id is permitted in browser JS. The PayPal secret
# stays server-side (Lambda + Secrets Manager). For local dev use a sandbox
# client-id; production swaps to live at deploy time.
PUBLIC_PAYPAL_CLIENT_ID=TODO

# Allowlist of origin sites that may redirect into /subscribe with ?origin=...
# Comma-separated full origins. Empty means /subscribe is reachable only by
# direct navigation (no return-redirect after PayPal completion).
PUBLIC_SUBSCRIBE_ALLOWED_ORIGINS=https://app.voxivium.com,https://politician.voxivium.com

# Voxivium API base URL used by /subscribe to confirm entitlement
# post-PayPal. Production: https://api.voxivium.com. Dev: http://localhost:8080.
PUBLIC_VOXIVIUM_API_BASE=https://api.voxivium.com

# PayPal plan IDs (provisioned by deploy/scripts/paypal_provision_catalog.py).
# One per subscription tier. Empty values mean the corresponding tier's
# Smart Buttons won't mount — the /subscribe page surfaces a "backend
# not wired" notice in that case. See deploy/scripts/README.md.
PUBLIC_PAYPAL_PLAN_ID_CIVIC_CONTRIBUTOR=
