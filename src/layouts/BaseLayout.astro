---
import interWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url'
import '@fontsource-variable/inter'
import '@styles/global.css'
import { Image } from 'astro:assets'
import headerLogo from '@assets/images/vox-logo-header.png'
import JsonLd from '@components/seo/JsonLd.astro'
import {
  breadcrumbSchema,
  organizationSchema,
  personSchema,
  websiteSchema,
  type Breadcrumb,
} from '@lib/seo'

interface Props {
  title: string
  description?: string
  ogImage?: string
  /** Alt text for the OG/Twitter card image. Social clients read this aloud. */
  ogImageAlt?: string
  canonical?: string
  /** Keep this page out of search indexes. Use for transactional/utility routes. */
  noindex?: boolean
  /** OpenGraph object type. `article` for /insights posts, `website` elsewhere. */
  ogType?: 'website' | 'article'
  /** Article-only OG metadata. Ignored unless ogType === 'article'. */
  publishedTime?: string
  modifiedTime?: string
  author?: string
  /** Trail from home to this page. Omit on the home page itself. */
  breadcrumbs?: Breadcrumb[]
  /** Extra JSON-LD nodes merged into this page's @graph (FAQPage, Article, …). */
  schema?: Record<string, unknown>[]
}

const {
  title,
  description = 'Voxivium is a non-partisan political accountability platform connecting citizens with their elected officials.',
  ogImage = '/og/default.png',
  ogImageAlt = 'Voxivium — see how your representatives actually vote.',
  canonical,
  noindex = false,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  author,
  breadcrumbs,
  schema = [],
} = Astro.props

const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site).toString()
const ogImageURL = new URL(ogImage, Astro.site).toString()

// Organization and WebSite are asserted on every indexable page so the entity
// resolves no matter which page a crawler reaches first. Noindexed pages skip
// the graph entirely — there's nothing to describe to a search engine there.
const graph = noindex
  ? []
  : [
      organizationSchema(),
      websiteSchema(),
      personSchema(),
      ...(breadcrumbs?.length ? [breadcrumbSchema(breadcrumbs)] : []),
      ...schema,
    ]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    {
      noindex ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : (
        <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
      )
    }

    {/* Discovered in the raw HTML, so the font fetch starts before the CSS parses. */}
    <link rel="preload" href={interWoff2} as="font" type="font/woff2" crossorigin />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Voxivium" />
    <meta property="og:locale" content="en_US" />
    {ogType === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {ogType === 'article' && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime} />
    )}
    {ogType === 'article' && author && <meta property="article:author" content={author} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {/* Matches the brand background per theme so mobile browser chrome doesn't flash. */}
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f0f6fa" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0a1117" />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
    <link rel="manifest" href="/favicon/site.webmanifest" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Voxivium Insights"
      href="/rss.xml"
    />

    <meta name="generator" content={Astro.generator} />

    {graph.length > 0 && <JsonLd schema={graph} />}

    <script is:inline>
      ;(() => {
        try {
          const stored = localStorage.getItem('theme')
          const prefersLight = window.matchMedia('(prefers-color-scheme: light)').matches
          const theme = stored ?? (prefersLight ? 'light' : 'dark')
          if (theme === 'dark') document.documentElement.classList.add('dark')
          document.documentElement.dataset.theme = theme
        } catch {
          document.documentElement.classList.add('dark')
        }
      })()
    </script>
  </head>
  <body>
    <a
      href="#main"
      class="focus:bg-brand-surface focus:text-brand-text1 sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded focus:px-4 focus:py-2 focus:shadow"
    >
      Skip to content
    </a>

    <header class="border-brand-el1 bg-brand-bg/80 sticky top-0 z-40 border-b backdrop-blur">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-6 py-3">
        <a href="/" class="flex items-center" aria-label="Voxivium home">
          {/*
            Sits in the header on every page, so it competes with LCP. Served
            through astro:assets to get WebP at display size instead of the
            1280x440 press-kit original. The press-kit copy under
            /press/ is left untouched — journalists link to it directly.
          */}
          <Image
            src={headerLogo}
            alt="Voxivium"
            width={224}
            height={77}
            densities={[1, 2]}
            loading="eager"
            fetchpriority="high"
            class="h-10 w-auto md:h-14"
          />
        </a>

        <nav class="hidden items-center gap-6 lg:flex" aria-label="Primary">
          <a href="/" class="text-brand-text2 hover:text-brand-primary transition-colors">Home</a>
          <a href="/about" class="text-brand-text2 hover:text-brand-primary transition-colors">
            About
          </a>
          <a
            href="/partnerships"
            class="text-brand-text2 hover:text-brand-primary transition-colors"
          >
            Partnerships
          </a>
          <a href="/insights" class="text-brand-text2 hover:text-brand-primary transition-colors">
            Insights
          </a>
          <a href="/faq" class="text-brand-text2 hover:text-brand-primary transition-colors">
            FAQ
          </a>
          <a href="/donate" class="text-brand-text2 hover:text-brand-primary transition-colors">
            Support us
          </a>
          <a
            href="/#voters"
            class="bg-brand-primary rounded-md px-4 py-2 font-semibold text-brand-onPrimary transition-opacity hover:opacity-90"
          >
            Get early access
          </a>
        </nav>

        <div class="flex items-center gap-1">
          <button
            id="theme-toggle"
            type="button"
            aria-label="Toggle color theme"
            class="text-brand-text2 hover:bg-brand-surface rounded-md p-2 transition-colors"
          >
            <svg
              class="hidden h-5 w-5 dark:block"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="5"></circle>
              <path
                d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"
              ></path>
            </svg>
            <svg
              class="h-5 w-5 dark:hidden"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
          </button>

          <button
            id="mobile-menu-toggle"
            type="button"
            aria-label="Open menu"
            aria-controls="mobile-menu"
            aria-expanded="false"
            class="text-brand-text2 hover:bg-brand-surface rounded-md p-2 transition-colors lg:hidden"
          >
            <svg
              class="h-5 w-5"
              data-icon="open"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <path d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
            <svg
              class="hidden h-5 w-5"
              data-icon="close"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <path d="M6 6l12 12M6 18L18 6"></path>
            </svg>
          </button>
        </div>
      </div>

      <nav
        id="mobile-menu"
        class="border-brand-el1 hidden border-t lg:hidden"
        aria-label="Mobile primary"
      >
        <div class="mx-auto flex max-w-6xl flex-col px-6 py-3">
          <a
            href="/"
            class="text-brand-text2 hover:bg-brand-surface hover:text-brand-primary rounded-md px-3 py-2 transition-colors"
            >Home</a
          >
          <a
            href="/about"
            class="text-brand-text2 hover:bg-brand-surface hover:text-brand-primary rounded-md px-3 py-2 transition-colors"
            >About</a
          >
          <a
            href="/partnerships"
            class="text-brand-text2 hover:bg-brand-surface hover:text-brand-primary rounded-md px-3 py-2 transition-colors"
            >Partnerships</a
          >
          <a
            href="/insights"
            class="text-brand-text2 hover:bg-brand-surface hover:text-brand-primary rounded-md px-3 py-2 transition-colors"
            >Insights</a
          >
          <a
            href="/faq"
            class="text-brand-text2 hover:bg-brand-surface hover:text-brand-primary rounded-md px-3 py-2 transition-colors"
            >FAQ</a
          >
          <a
            href="/donate"
            class="text-brand-text2 hover:bg-brand-surface hover:text-brand-primary rounded-md px-3 py-2 transition-colors"
            >Support us</a
          >
          <a
            href="/#voters"
            class="bg-brand-primary mt-2 rounded-md px-4 py-2 text-center font-semibold text-brand-onPrimary transition-opacity hover:opacity-90"
            >Get early access</a
          >
        </div>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="border-brand-el1 bg-brand-surface mt-24 border-t">
      <div
        class="text-brand-text3 mx-auto flex max-w-6xl flex-col gap-4 px-6 py-8 text-sm md:flex-row md:items-center md:justify-between"
      >
        <p>&copy; {new Date().getFullYear()} Voxivium, PBC. All rights reserved.</p>
        <nav aria-label="Legal" class="flex gap-6">
          <a href="/security" class="hover:text-brand-primary transition-colors">Security</a>
          <a href="/legal/privacy" class="hover:text-brand-primary transition-colors">Privacy</a>
          <a href="/legal/terms" class="hover:text-brand-primary transition-colors">Terms</a>
        </nav>
      </div>
    </footer>

    <script is:inline>
      const toggle = document.getElementById('theme-toggle')
      toggle?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark')
        const theme = isDark ? 'dark' : 'light'
        try {
          localStorage.setItem('theme', theme)
        } catch {
          /* no-op */
        }
        document.documentElement.dataset.theme = theme
      })

      const mobileToggle = document.getElementById('mobile-menu-toggle')
      const mobileMenu = document.getElementById('mobile-menu')

      function setMobileMenuOpen(open) {
        if (!mobileToggle || !mobileMenu) return
        mobileToggle.setAttribute('aria-expanded', String(open))
        mobileToggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu')
        mobileMenu.classList.toggle('hidden', !open)
        const openIcon = mobileToggle.querySelector('[data-icon="open"]')
        const closeIcon = mobileToggle.querySelector('[data-icon="close"]')
        openIcon?.classList.toggle('hidden', open)
        closeIcon?.classList.toggle('hidden', !open)
      }

      mobileToggle?.addEventListener('click', () => {
        const isOpen = mobileToggle.getAttribute('aria-expanded') === 'true'
        setMobileMenuOpen(!isOpen)
      })

      // Close mobile menu when navigating or pressing Escape.
      mobileMenu?.addEventListener('click', (event) => {
        if (event.target instanceof HTMLAnchorElement) setMobileMenuOpen(false)
      })

      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return
        if (mobileToggle?.getAttribute('aria-expanded') === 'true') setMobileMenuOpen(false)
      })
    </script>
  </body>
</html>
