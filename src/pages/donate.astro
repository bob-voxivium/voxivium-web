---
import BaseLayout from '@layouts/BaseLayout.astro'
import OnboardingFundLiveStatus from '@components/sections/OnboardingFundLiveStatus.astro'

// Voter Onboarding Fund donations — PayPal one-time payments. $2 minimum
// (covers the donor's own onboarding + at least one more voter); presets
// $25 / $50 / $100 plus custom.
//
// Per CEO #5 / features.md §12.2 / §13.2: small ($2 / $10) in-app IAPs
// stay app-side; the web /donate page is for *anyone* who wants to
// chip in, and is also the destination for the in-app "Donate more"
// CTA that bounces users out to better processor economics.
//
// Backend wiring status (2026-06-18): voxivium-mvp ships
// `POST /donate/create` (PayPal Order) and `POST /webhooks/paypal`
// (PAYMENT.CAPTURE.COMPLETED → fund_ledger credit). This page still
// needs (separate session): (1) Cloudflare Turnstile widget + token
// capture, (2) request-body alignment with the Go handler's
// {amount_cents, turnstile_token} shape, (3) PayPal Smart Buttons
// mount once the prior two land. The page renders the live fund
// status today (read-only against the new GET /api/fund/status).
//
// No sign-in required — donors are not necessarily Voxivium users.

const paypalClientID = import.meta.env.PUBLIC_PAYPAL_CLIENT_ID
// voxiviumAPIBase will be referenced again once the Turnstile-gated
// PayPal Smart Buttons mount returns; the OnboardingFundLiveStatus
// component already reads PUBLIC_VOXIVIUM_API_BASE directly for the
// live balance fetch.
---

<BaseLayout
  title="Donate to the Voter Onboarding Fund"
  description="Every dollar you donate goes towards onboarding a new user."
>
  <section class="container mx-auto max-w-2xl px-6 py-16">
    <p class="eyebrow text-brand-text3 text-sm font-medium tracking-wide uppercase">
      Voter Onboarding Fund
    </p>
    <h1 class="text-brand-text1 mt-2 text-3xl font-semibold">
      Every dollar you donate goes towards onboarding a new user.
    </h1>
    <p class="text-brand-text2 mt-4 text-lg">
      Every Voxivium voter is identity-verified and matched against their
      voter registration before their voice contributes to district
      aggregates. Each new verified voter costs us around $1 in third-party
      service fees. The Voter Onboarding Fund covers that cost so signup
      stays free for the citizen.
    </p>
    <p class="text-brand-text3 mt-4 text-sm">
      Voxivium is a Public Benefit Corporation. Donations are not
      tax-deductible. Funds are tracked transparently in our public ledger
      and used exclusively to cover voter onboarding costs.
    </p>

    <OnboardingFundLiveStatus class="mt-10" />

    <div class="border-brand-el1 bg-brand-surface mt-10 rounded-lg border p-6">
      <h2 class="text-brand-text1 text-xl font-semibold">Choose an amount</h2>

      <fieldset class="mt-6">
        <legend class="sr-only">Donation amount</legend>
        <div class="grid grid-cols-3 gap-3">
          <label class="border-brand-el1 hover:bg-brand-el1 has-checked:border-brand-primary has-checked:bg-brand-el1 cursor-pointer rounded-md border p-3 text-center transition-colors">
            <input type="radio" name="amount" value="25" class="sr-only" checked />
            <span class="text-brand-text1 block text-lg font-semibold">$25</span>
            <span class="text-brand-text3 text-xs">≈ 25 voters</span>
          </label>
          <label class="border-brand-el1 hover:bg-brand-el1 has-checked:border-brand-primary has-checked:bg-brand-el1 cursor-pointer rounded-md border p-3 text-center transition-colors">
            <input type="radio" name="amount" value="50" class="sr-only" />
            <span class="text-brand-text1 block text-lg font-semibold">$50</span>
            <span class="text-brand-text3 text-xs">≈ 50 voters</span>
          </label>
          <label class="border-brand-el1 hover:bg-brand-el1 has-checked:border-brand-primary has-checked:bg-brand-el1 cursor-pointer rounded-md border p-3 text-center transition-colors">
            <input type="radio" name="amount" value="100" class="sr-only" />
            <span class="text-brand-text1 block text-lg font-semibold">$100</span>
            <span class="text-brand-text3 text-xs">≈ 100 voters</span>
          </label>
        </div>
      </fieldset>

      <div class="mt-6">
        <label for="amount-custom" class="text-brand-text2 block text-sm font-medium">
          Or enter a custom amount (USD, $2 minimum)
        </label>
        <div class="mt-1 flex items-center gap-2">
          <span class="text-brand-text3 text-lg">$</span>
          <input
            id="amount-custom"
            type="number"
            inputmode="decimal"
            step="0.01"
            min="2"
            class="border-brand-el1 bg-brand-bg text-brand-text1 focus:border-brand-primary block w-full rounded-md border px-3 py-2"
            placeholder=""
            aria-describedby="amount-custom-help"
          />
        </div>
        <p id="amount-custom-help" class="text-brand-text3 mt-1 text-xs">
          Entering a custom amount overrides the preset above. $2 covers
          your own onboarding plus one additional voter. Pay it forward!
        </p>
      </div>

      <!-- PayPal Smart Buttons mount target -->
      <div id="paypal-donate-button-container" class="mt-8"></div>

      <!-- Surfaces while the Turnstile widget + body-shape wiring are still TODO. -->
      <div data-state="backend-missing" hidden class="border-brand-el1 mt-6 rounded-lg border-2 border-dashed p-4">
        <p class="text-brand-text3 text-sm">
          <strong class="text-brand-text2">Backend wiring TODO.</strong>
          Server endpoints are shipped on voxivium-mvp
          (<code class="bg-brand-bg rounded px-1">POST /donate/create</code> +
          <code class="bg-brand-bg rounded px-1">POST /webhooks/paypal</code>);
          this page still needs Cloudflare Turnstile widget integration
          and request-body alignment before PayPal Smart Buttons can mount.
          See features.md §12.2 follow-ups.
        </p>
      </div>

      <p data-form-status class="form-status mt-4" hidden></p>
    </div>
  </section>

  <script
    is:inline
    define:vars={{ paypalClientID }}
    type="module"
  >
    // Until the Turnstile widget lands on this page, gate Smart Buttons
    // off entirely and surface the TODO note. Keeps the form usable for
    // copy review without exposing a broken submit path. The amount-pick
    // helpers + Smart Buttons mount come back when Turnstile lands; see
    // features.md §12.2 follow-ups.
    const bm = document.querySelector('[data-state="backend-missing"]')
    if (bm) bm.hidden = false

    if (paypalClientID && paypalClientID !== 'TODO') {
      // eslint-disable-next-line no-console
      console.info('paypal client id present; awaiting turnstile widget integration before mount')
    }

    // Custom-amount + preset toggle wiring (no submit path yet).
    const customInput = document.getElementById('amount-custom')
    customInput?.addEventListener('input', () => {
      if (customInput.value.trim()) {
        const checked = document.querySelector('input[name="amount"]:checked')
        if (checked) checked.checked = false
      }
    })

    document.querySelectorAll('input[name="amount"]').forEach((radio) => {
      radio.addEventListener('change', () => {
        if (customInput) customInput.value = ''
      })
    })
  </script>
</BaseLayout>
