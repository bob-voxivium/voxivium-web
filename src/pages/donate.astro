---
import BaseLayout from '@layouts/BaseLayout.astro'
import OnboardingFundLiveStatus from '@components/sections/OnboardingFundLiveStatus.astro'

// Voter Onboarding Fund donations — PayPal one-time payments. $2 minimum
// (covers the donor's own onboarding + at least one more voter); presets
// $25 / $50 / $100 plus custom.
//
// Per CEO #5 / features.md §12.2 / §13.2: small ($2 / $10) in-app IAPs
// stay app-side; the web /donate page is for *anyone* who wants to
// chip in, and is also the destination for the in-app "Donate more"
// CTA that bounces users out to better processor economics.
//
// Wiring (2026-06-19): Cloudflare Turnstile widget renders inline; the
// PayPal Smart Buttons mount only after PUBLIC_PAYPAL_CLIENT_ID is set.
// On the buttons' createOrder, we read the Turnstile response token
// from the hidden `cf-turnstile-response` input the widget injects,
// post {amount_cents, turnstile_token} to voxivium-mvp's
// POST /donate/create (no /api/ prefix — that's a v1 path, donate is
// at root), and return the PayPal order id to the SDK. Capture happens
// server-side via the PAYMENT.CAPTURE.COMPLETED webhook which writes
// the fund_ledger row.
//
// No sign-in required — donors are not necessarily Voxivium users.

const paypalClientID = import.meta.env.PUBLIC_PAYPAL_CLIENT_ID
const voxiviumAPIBase = import.meta.env.PUBLIC_VOXIVIUM_API_BASE
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY
---

<BaseLayout
  title="Donate to the Voter Onboarding Fund — Voxivium"
  description="Voter verification costs Voxivium money per person. Every dollar you donate covers onboarding for another verified voter. $2 minimum, no subscription."
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Support us', path: '/donate' },
  ]}
>
  <section class="container mx-auto max-w-2xl px-6 py-16">
    <p class="eyebrow text-brand-text3 text-sm font-medium tracking-wide uppercase">
      Voter Onboarding Fund
    </p>
    <h1 class="text-brand-text1 mt-2 text-3xl font-semibold">
      Every dollar you donate goes towards onboarding a new user.
    </h1>
    <p class="text-brand-text2 mt-4 text-lg">
      Every Voxivium voter is identity-verified and matched against their
      voter registration before their voice contributes to district
      aggregates. Each new verified voter costs us around $1 in third-party
      service fees. The Voter Onboarding Fund covers that cost so signup
      stays free for the citizen.
    </p>
    <p class="text-brand-text3 mt-4 text-sm">
      Voxivium is a Public Benefit Corporation. Donations are not
      tax-deductible. Funds are tracked transparently in our public ledger
      and used exclusively to cover voter onboarding costs.
    </p>

    <OnboardingFundLiveStatus class="mt-10" />

    <div class="border-brand-el1 bg-brand-surface mt-10 rounded-lg border p-6">
      <h2 class="text-brand-text1 text-xl font-semibold">Choose an amount</h2>

      <fieldset class="mt-6">
        <legend class="sr-only">Donation amount</legend>
        <div class="grid grid-cols-3 gap-3">
          <label class="border-brand-el1 hover:bg-brand-el1 has-checked:border-brand-primary has-checked:bg-brand-el1 cursor-pointer rounded-md border p-3 text-center transition-colors">
            <input type="radio" name="amount" value="25" class="sr-only" checked />
            <span class="text-brand-text1 block text-lg font-semibold">$25</span>
            <span class="text-brand-text3 text-xs">≈ 25 voters</span>
          </label>
          <label class="border-brand-el1 hover:bg-brand-el1 has-checked:border-brand-primary has-checked:bg-brand-el1 cursor-pointer rounded-md border p-3 text-center transition-colors">
            <input type="radio" name="amount" value="50" class="sr-only" />
            <span class="text-brand-text1 block text-lg font-semibold">$50</span>
            <span class="text-brand-text3 text-xs">≈ 50 voters</span>
          </label>
          <label class="border-brand-el1 hover:bg-brand-el1 has-checked:border-brand-primary has-checked:bg-brand-el1 cursor-pointer rounded-md border p-3 text-center transition-colors">
            <input type="radio" name="amount" value="100" class="sr-only" />
            <span class="text-brand-text1 block text-lg font-semibold">$100</span>
            <span class="text-brand-text3 text-xs">≈ 100 voters</span>
          </label>
        </div>
      </fieldset>

      <div class="mt-6">
        <label for="amount-custom" class="text-brand-text2 block text-sm font-medium">
          Or enter a custom amount (USD, $2 minimum)
        </label>
        <div class="mt-1 flex items-center gap-2">
          <span class="text-brand-text3 text-lg">$</span>
          <input
            id="amount-custom"
            type="number"
            inputmode="decimal"
            step="0.01"
            min="2"
            class="border-brand-el1 bg-brand-bg text-brand-text1 focus:border-brand-primary block w-full rounded-md border px-3 py-2"
            placeholder=""
            aria-describedby="amount-custom-help"
          />
        </div>
        <p id="amount-custom-help" class="text-brand-text3 mt-1 text-xs">
          Entering a custom amount overrides the preset above. $2 covers
          your own onboarding plus one additional voter. Pay it forward!
        </p>
      </div>

      <!-- Cloudflare Turnstile widget. data-action lets the server-side
           verifier scope the token to this surface. -->
      <div class="mt-6">
        <div
          class="cf-turnstile"
          data-sitekey={turnstileSiteKey}
          data-action="donate-create"
          data-theme="auto"
        >
        </div>
        <p
          class="text-brand-text3 mt-1 text-xs"
          data-state="turnstile-missing-key"
          hidden
        >
          Anti-bot challenge not configured (PUBLIC_TURNSTILE_SITE_KEY missing).
        </p>
      </div>

      <!-- PayPal Smart Buttons mount target -->
      <div id="paypal-donate-button-container" class="mt-8"></div>

      <!-- Surfaces when PayPal client id is absent (dev placeholder). -->
      <div
        data-state="paypal-missing"
        hidden
        class="border-brand-el1 mt-6 rounded-lg border-2 border-dashed p-4"
      >
        <p class="text-brand-text3 text-sm">
          <strong class="text-brand-text2">PayPal client id missing.</strong>
          Set <code class="bg-brand-bg rounded px-1">PUBLIC_PAYPAL_CLIENT_ID</code>
          in <code class="bg-brand-bg rounded px-1">.env.local</code> to mount
          the Smart Buttons.
        </p>
      </div>

      <p data-form-status class="form-status mt-4" hidden></p>
    </div>
  </section>

  <!-- Turnstile API. Auto-renders any .cf-turnstile element on the page. -->
  <script
    is:inline
    src="https://challenges.cloudflare.com/turnstile/v0/api.js"
    async
    defer></script>

  <script
    is:inline
    define:vars={{ paypalClientID, voxiviumAPIBase, turnstileSiteKey }}
    type="module"
  >
    function selectedAmountCents() {
      const custom = document.getElementById('amount-custom')
      const customValue = custom?.value?.trim()
      if (customValue) {
        const parsed = Number(customValue)
        if (Number.isFinite(parsed) && parsed >= 2) {
          return Math.round(parsed * 100)
        }
      }
      const radio = document.querySelector('input[name="amount"]:checked')
      const presetValue = radio ? Number(radio.value) : NaN
      const dollars = Number.isFinite(presetValue) ? presetValue : 25
      return Math.round(dollars * 100)
    }

    function getTurnstileToken() {
      // Cloudflare's widget injects a hidden input named
      // `cf-turnstile-response` into the same form / parent as the
      // .cf-turnstile div. We don't wrap in a <form> here, so search
      // the document.
      const input = document.querySelector('input[name="cf-turnstile-response"]')
      return input?.value?.trim() ?? ''
    }

    function resetTurnstile() {
      const widget = document.querySelector('.cf-turnstile')
      if (widget && window.turnstile && typeof window.turnstile.reset === 'function') {
        try {
          window.turnstile.reset(widget)
        } catch (_) {
          // best-effort reset; ignore
        }
      }
    }

    function surfaceStatus(msg, kind) {
      const el = document.querySelector('[data-form-status]')
      if (!el) return
      el.hidden = false
      el.textContent = msg
      if (kind) el.dataset.kind = kind
    }

    if (!turnstileSiteKey || turnstileSiteKey === 'TODO') {
      const missing = document.querySelector('[data-state="turnstile-missing-key"]')
      if (missing) missing.hidden = false
    }

    if (!paypalClientID || paypalClientID === 'TODO') {
      const miss = document.querySelector('[data-state="paypal-missing"]')
      if (miss) miss.hidden = false
    } else {
      const sdkSrc = `https://www.paypal.com/sdk/js?client-id=${encodeURIComponent(paypalClientID)}&currency=USD&intent=capture`
      const script = document.createElement('script')
      script.src = sdkSrc
      script.setAttribute('data-sdk-integration-source', 'voxivium-web')
      script.addEventListener('load', () => {
        if (!window.paypal) {
          surfaceStatus('PayPal SDK loaded but window.paypal not defined.', 'error')
          return
        }
        window.paypal
          .Buttons({
            style: { layout: 'vertical', label: 'donate', color: 'gold' },
            createOrder: async () => {
              const amountCents = selectedAmountCents()
              if (!Number.isFinite(amountCents) || amountCents < 200) {
                surfaceStatus('Please enter at least $2.', 'error')
                throw new Error('amount below minimum')
              }
              const token = getTurnstileToken()
              if (!token) {
                surfaceStatus(
                  'Please complete the anti-bot verification above before donating.',
                  'error',
                )
                throw new Error('turnstile token missing')
              }
              const response = await fetch(`${voxiviumAPIBase}/donate/create`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  amount_cents: amountCents,
                  turnstile_token: token,
                }),
              })
              if (!response.ok) {
                const body = await response.text().catch(() => '')
                surfaceStatus(
                  `Couldn't start the donation (${response.status}). Please try again.`,
                  'error',
                )
                throw new Error(`donate/create failed: ${response.status} ${body}`)
              }
              const data = await response.json()
              if (!data.paypal_order_id) {
                surfaceStatus(
                  "Server didn't return a PayPal order id; please retry.",
                  'error',
                )
                throw new Error('donate/create missing paypal_order_id')
              }
              return data.paypal_order_id
            },
            onApprove: async (paypalData) => {
              // Server-side capture is handled by the webhook
              // (PAYMENT.CAPTURE.COMPLETED → fund_ledger insert). Browser
              // just shows a thank-you while that lands.
              surfaceStatus(
                `Thank you! Your donation is being processed. PayPal order id: ${paypalData.orderID}`,
                'success',
              )
              // Reset the Turnstile widget so a repeat donation starts
              // fresh. The token we just consumed is single-use.
              resetTurnstile()
            },
            onCancel: () => {
              surfaceStatus('Donation cancelled. No charge was made.', 'info')
            },
            onError: (err) => {
              surfaceStatus(`PayPal error: ${err?.message ?? err}`, 'error')
            },
          })
          .render('#paypal-donate-button-container')
      })
      script.addEventListener('error', () => {
        surfaceStatus('Failed to load PayPal SDK. Check your network and try again.', 'error')
      })
      document.head.appendChild(script)
    }

    // Highlight the radio when the custom amount field is cleared / non-empty.
    const customInput = document.getElementById('amount-custom')
    customInput?.addEventListener('input', () => {
      if (customInput.value.trim()) {
        const checked = document.querySelector('input[name="amount"]:checked')
        if (checked) checked.checked = false
      }
    })

    document.querySelectorAll('input[name="amount"]').forEach((radio) => {
      radio.addEventListener('change', () => {
        if (customInput) customInput.value = ''
      })
    })
  </script>
</BaseLayout>
