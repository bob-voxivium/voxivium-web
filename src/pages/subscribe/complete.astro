---
import BaseLayout from '@layouts/BaseLayout.astro'

// Return target from PayPal Smart Buttons. The actual entitlement is
// confirmed by the PayPal subscription webhook (server-side, source of
// truth). This page polls the backend until the webhook lands (typically
// <5s), then bounces back to the originating site so the user lands in the
// app/portal with their subscription provisioned.
//
// On `status=cancelled` we surface a cancel screen with a "try again"
// link back to /subscribe (preserving plan + origin).
---

<BaseLayout
  title="Welcome to Voxivium"
  description="Finishing your subscription setup."
  noindex
>
  <section class="container mx-auto max-w-2xl px-6 py-16">
    <!-- Provisioning state -->
    <div data-state="provisioning" class="text-center">
      <h1 class="text-brand-text1 text-3xl font-semibold">Welcome — provisioning your subscription</h1>
      <p class="text-brand-text2 mt-4">
        PayPal confirmed your payment. We're activating your subscription now —
        this usually takes a few seconds. You'll be returned to the Voxivium
        app automatically.
      </p>
      <div class="text-brand-text3 mt-8 text-sm" aria-live="polite">
        <p data-poll-status>Checking entitlement…</p>
      </div>
    </div>

    <!-- Cancelled state -->
    <div data-state="cancelled" hidden class="text-center">
      <h1 class="text-brand-text1 text-3xl font-semibold">Subscription not completed</h1>
      <p class="text-brand-text2 mt-4">
        You cancelled before completing payment. No charge was made.
      </p>
      <p class="text-brand-text3 mt-8">
        <a
          data-retry-link
          href="/"
          class="bg-brand-primary inline-block rounded-md px-4 py-2 font-semibold text-brand-onPrimary"
        >
          Try again
        </a>
      </p>
    </div>

    <!-- Failed-provisioning state (polling exhausted) -->
    <div data-state="failed" hidden class="text-center">
      <h1 class="text-brand-text1 text-3xl font-semibold">Subscription pending</h1>
      <p class="text-brand-text2 mt-4">
        PayPal confirmed your payment, but we haven't yet received final
        confirmation from PayPal's webhook. Your subscription will be
        activated shortly — please open the Voxivium app in a few minutes.
      </p>
      <p class="text-brand-text3 mt-8 text-sm">
        If you don't see your subscription active within an hour, contact
        support with your PayPal subscription ID:
        <code data-subscription-id class="bg-brand-bg rounded px-1"></code>.
      </p>
    </div>
  </section>

  <!--
    Bundled, NOT is:inline (Bugs.md §4.c). An inline script ships verbatim,
    so the '/src/lib/*.ts' imports below used to reach production unresolved
    and 403 there — the module never loaded, and this page sat on its
    provisioning spinner forever after a user had already paid. It only
    worked in `astro dev`, where Vite serves and transpiles /src/* live.
  -->
  <script>
    import { onAuthChanged, getIdToken } from '@lib/firebase/client'
    import { resolveReturnOrigin } from '@lib/subscribe'

    const params = new URLSearchParams(window.location.search)
    const status = params.get('status')
    const subscriptionID = params.get('subscription_id') ?? ''
    const originSlug = params.get('origin')

    const states = {
      provisioning: document.querySelector('[data-state="provisioning"]'),
      cancelled: document.querySelector('[data-state="cancelled"]'),
      failed: document.querySelector('[data-state="failed"]'),
    }
    function show(name) {
      for (const [k, el] of Object.entries(states)) {
        if (!el) continue
        el.hidden = k !== name
      }
    }

    if (status === 'cancelled') {
      show('cancelled')
      const retry = document.querySelector('[data-retry-link]')
      if (retry && originSlug) {
        const back = resolveReturnOrigin(originSlug)
        if (back) retry.setAttribute('href', back)
      }
    } else if (status !== 'success') {
      // Unknown status — show provisioning as the safest default. The poll
      // loop won't find an entitlement and will land on the failed-state
      // copy, which is the same UX a user would see if PayPal returned
      // with no useful status.
      show('provisioning')
    } else {
      show('provisioning')
      const sidEl = document.querySelector('[data-subscription-id]')
      if (sidEl) sidEl.textContent = subscriptionID
      // Same guard as /subscribe (Bugs.md §4.c): getFirebaseAuth() throws on
      // missing PUBLIC_FIREBASE_* config, which would abort this module and
      // leave the "provisioning" spinner up forever. That is a worse failure
      // here than on /subscribe — this user has already been charged — so
      // fall through to the pending copy, which tells them their payment is
      // safe and gives them their subscription ID.
      try {
        onAuthChanged(async (user) => {
          if (!user) {
            // Lost the session — bounce to /subscribe to re-auth (the user
            // can re-auth and we'll re-check entitlement on next poll).
            window.location.assign('/subscribe')
            return
          }
          await pollAndBounce()
        })
      } catch (err) {
        console.error('subscribe/complete: auth check failed', err)
        show('failed')
      }
    }

    async function pollAndBounce() {
      const voxiviumAPIBase = import.meta.env.PUBLIC_VOXIVIUM_API_BASE
      const statusEl = document.querySelector('[data-poll-status]')
      const start = Date.now()
      const timeoutMs = 60_000
      const intervalMs = 2_000

      while (Date.now() - start < timeoutMs) {
        try {
          const idToken = await getIdToken()
          // /api/v1 prefix is required — every voter route is mounted under
          // it (cmd/api/main.go: apiGroup := e.Group("/api/v1")). Without it
          // the poll 404s on every attempt, so a successful subscription
          // still ended in the 60-second timeout and the "pending" screen.
          // The sibling call in subscribe.astro already had the prefix.
          const response = await fetch(`${voxiviumAPIBase}/api/v1/voter/subscription`, {
            headers: { Authorization: `Bearer ${idToken}` },
          })
          if (response.ok) {
            const data = await response.json()
            if (data?.active === true) {
              if (statusEl) statusEl.textContent = 'Activated. Returning to the app…'
              bounceToOrigin()
              return
            }
          }
        } catch {
          /* swallow — the loop will retry */
        }
        await new Promise((r) => setTimeout(r, intervalMs))
      }

      show('failed')
    }

    function bounceToOrigin() {
      if (!originSlug) return
      const back = resolveReturnOrigin(originSlug)
      if (!back) return
      const url = new URL('/subscribe/complete', back)
      url.searchParams.set('status', 'success')
      url.searchParams.set('subscription_id', subscriptionID)
      window.location.assign(url.toString())
    }
  </script>
</BaseLayout>
