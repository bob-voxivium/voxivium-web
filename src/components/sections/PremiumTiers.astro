---
/**
 * Voter Premium pricing ladder.
 *
 * The job of this component is to stop three prices reading as
 * cheap → expensive → very expensive. $49.95 for five years is $9.99/year,
 * half the annual rate, but a reader scanning bare numbers will pick the
 * smallest one unless the comparison is spelled out. Hence the value line
 * and the "Best value" ribbon on the middle tier.
 *
 * Data comes from PREMIUM_TIERS in src/lib/subscribe.ts — the same file the
 * checkout page reads its purchasable catalog from, so the two can't drift
 * into quoting different prices for the same product.
 */
import { PREMIUM_TIERS } from '@lib/subscribe'

interface Props {
  /** Heading level, so the section can sit under an existing h1 or stand alone. */
  headingLevel?: 'h1' | 'h2'
}

const { headingLevel = 'h2' } = Astro.props
const Heading = headingLevel

const voxiviumAPIBase = import.meta.env.PUBLIC_VOXIVIUM_API_BASE ?? ''
---

<section class="tiers-section">
  <p class="eyebrow">Voxivium Premium</p>
  <Heading class="tiers-title">Voter accounts are free. Premium goes deeper.</Heading>
  <p class="tiers-intro">
    Accountability scorecards for the officials who represent you are free,
    always. Premium
    adds a monthly AI analysis weighing each official's record against the
    beliefs you marked most important, plus search across every elected
    official in the country.
  </p>

  <ul class="tiers-grid" role="list">
    {
      PREMIUM_TIERS.map((tier) => (
        <li
          class:list={['tier-card', { featured: tier.badge === 'Best value' }]}
          data-tier
          data-tier-name={tier.name}
        >
          <div class="tier-head">
            <h3 class="tier-name">{tier.name}</h3>
            {tier.badge && <span class="tier-badge">{tier.badge}</span>}
          </div>

          <p class="tier-price">
            <span class="amount" data-tier-amount>{tier.priceLabel}</span>
            <span class="term" data-tier-term>{tier.termLabel}</span>
          </p>

          {/* Rendered even when empty so the live read has a node to fill —
              the yearly tier is the baseline and carries no value line until
              the API confirms it is still the baseline. */}
          <p class="tier-value" data-tier-value hidden={!tier.valueLabel}>
            {tier.valueLabel}
          </p>

          <p class="tier-cycle">{tier.cycleLine}</p>
          <p class="tier-renewal" data-tier-renewal>{tier.renewalLine}</p>

          {tier.purchasableOnWeb ? (
            <a class="tier-cta" href="/subscribe?plan=premium-subscriber-yearly&origin=kmp-web">
              Subscribe
            </a>
          ) : (
            <p class="tier-app-only">Available in the Voxivium app for iPhone and Android.</p>
          )}
        </li>
      ))
    }
  </ul>

  <p class="tiers-footnote">
    Prices in USD. Purchases made in the app are billed by Apple or Google at
    their listed price. Voxivium is a Public Benefit Corporation — subscriptions
    fund the product and help onboard new verified voters.
  </p>
</section>

<script is:inline define:vars={{ voxiviumAPIBase }} type="module">
  // Live price read from voxivium-mvp GET /api/pricing (anonymous, cached).
  //
  // The card markup above is server-rendered from PREMIUM_TIERS, so the page
  // is complete, correct and indexable with JavaScript disabled or the API
  // down. This only *reconciles* it against subscription_plan, which is what
  // stops a price change in the database leaving the marketing site quoting
  // last quarter's number.
  //
  // Tiers are matched by plan name — the same string the store product,
  // subscription_plan.name and the app all key on.
  if (voxiviumAPIBase) {
    const cards = document.querySelectorAll('[data-tier]:not([data-tier-bound])')
    if (cards.length) {
      cards.forEach((el) => el.setAttribute('data-tier-bound', ''))

      const monthsOf = (t) => {
        if (t.duration_unit === 'YEAR') return t.duration_value * 12
        if (t.duration_unit === 'MONTH') return t.duration_value
        return 0
      }
      // Lifetime by either signal, mirroring the app: a term at or beyond the
      // 100-year horizon must never be annualized, or $99 becomes $0.99/year
      // and the lifetime tier claims a 95% saving.
      const isLifetime = (t) => t.lifetime === true || monthsOf(t) >= 1200
      const annualCents = (t) => {
        const m = monthsOf(t)
        if (isLifetime(t) || !m || !t.price_cents) return null
        return (t.price_cents * 12) / m
      }
      const usd = (cents) => {
        const whole = Math.floor(cents / 100)
        const rem = Math.round(cents % 100)
        return `$${whole}.${String(rem).padStart(2, '0')}`
      }
      const termOf = (t) => {
        if (isLifetime(t)) return 'one payment, forever'
        if (t.renews && monthsOf(t) === 12) return 'per year'
        if (t.duration_unit === 'YEAR') return `one payment, ${t.duration_value} years`
        return `one payment, ${t.duration_value} ${t.duration_unit.toLowerCase()}`
      }

      fetch(`${voxiviumAPIBase}/api/pricing`, { credentials: 'omit' })
        .then((r) => (r.ok ? r.json() : Promise.reject(new Error(`HTTP ${r.status}`))))
        .then((data) => {
          const tiers = Array.isArray(data?.tiers) ? data.tiers : []
          if (!tiers.length) return

          // Baseline is the most expensive year — in practice the yearly
          // plan. Savings are quoted against it.
          const annuals = tiers.map(annualCents).filter((v) => v !== null)
          const baseline = annuals.length ? Math.max(...annuals) : null

          tiers.forEach((t) => {
            const card = document.querySelector(`[data-tier][data-tier-name="${CSS.escape(t.name)}"]`)
            if (!card) return

            const amountEl = card.querySelector('[data-tier-amount]')
            if (amountEl && t.price_cents) amountEl.textContent = usd(t.price_cents)

            const termEl = card.querySelector('[data-tier-term]')
            if (termEl) termEl.textContent = termOf(t)

            const renewalEl = card.querySelector('[data-tier-renewal]')
            if (renewalEl) {
              renewalEl.textContent = isLifetime(t)
                ? 'One payment. Never expires.'
                : t.renews
                  ? 'Renews automatically. Cancel anytime.'
                  : 'One payment. Does not renew automatically.'
            }

            const valueEl = card.querySelector('[data-tier-value]')
            if (!valueEl) return
            const annual = annualCents(t)
            let line = ''
            if (isLifetime(t)) {
              line = 'One payment. Never pay again.'
            } else if (baseline && annual !== null) {
              const pct = Math.round(((baseline - annual) / baseline) * 100)
              // Below 5% the discount is not worth a claim.
              if (pct >= 5) line = `${usd(annual)}/year equivalent — save ${pct}%`
            }
            valueEl.textContent = line
            valueEl.hidden = line === ''
          })
        })
        .catch(() => {
          // Server-rendered prices stand. A marketing page must never blank
          // its own price list because a fetch failed.
        })
    }
  }
</script>

<style>
  .tiers-section {
    max-width: 72rem;
    margin-inline: auto;
    padding: 4rem 1.5rem;
  }

  .eyebrow {
    color: var(--color-brand-text3);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .tiers-title {
    color: var(--color-brand-text1);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 600;
    margin-top: 0.5rem;
  }

  .tiers-intro {
    color: var(--color-brand-text2);
    margin-top: 0.75rem;
    max-width: 46rem;
    line-height: 1.6;
  }

  .tiers-grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
    margin-top: 2.5rem;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 48rem) {
    .tiers-grid {
      grid-template-columns: repeat(3, 1fr);
      align-items: start;
    }
  }

  /* Surface matches FeatureCard: 24px corners, ~5% TL→BR gradient, diffuse
     low-alpha shadow. Per KMP STYLE_GUIDE §1–2, mirrored on the web. */
  .tier-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    height: 100%;
    padding: 1.75rem;
    border-radius: 1.5rem;
    border: 1px solid color-mix(in oklab, var(--color-brand-text1), transparent 88%);
    background:
      linear-gradient(
        135deg,
        color-mix(in oklab, var(--color-brand-surface), white 4%) 0%,
        var(--color-brand-surface) 60%,
        color-mix(in oklab, var(--color-brand-surface), black 3%) 100%
      );
    box-shadow: 0 24px 48px -32px rgba(0, 0, 0, 0.05);
  }

  :global(html.dark) .tier-card {
    background:
      linear-gradient(
        135deg,
        color-mix(in oklab, var(--color-brand-surface), white 5%) 0%,
        var(--color-brand-surface) 60%,
        color-mix(in oklab, var(--color-brand-surface), black 8%) 100%
      );
    box-shadow: 0 24px 48px -32px rgba(0, 0, 0, 0.5);
  }

  /* The value tier gets a ring rather than a scale transform — growing one
     card shifts the row's baseline and makes the other two feel demoted. */
  .tier-card.featured {
    border-color: var(--color-brand-primary);
    box-shadow:
      0 0 0 1px var(--color-brand-primary),
      0 24px 48px -32px rgba(0, 0, 0, 0.08);
  }

  .tier-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .tier-name {
    color: var(--color-brand-text1);
    font-size: 1.0625rem;
    font-weight: 600;
  }

  .tier-badge {
    background: var(--color-brand-primary);
    color: var(--color-brand-on-primary);
    border-radius: 999px;
    padding: 0.25rem 0.625rem;
    font-size: 0.75rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .tier-price {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: 0.75rem;
  }

  .amount {
    color: var(--color-brand-text1);
    font-size: 2.25rem;
    font-weight: 700;
    line-height: 1.1;
  }

  .term {
    color: var(--color-brand-text3);
    font-size: 0.9375rem;
  }

  .tier-value {
    color: var(--color-brand-primary);
    font-weight: 600;
  }

  .tier-cycle {
    color: var(--color-brand-text2);
  }

  .tier-renewal {
    color: var(--color-brand-text3);
    font-size: 0.875rem;
  }

  .tier-cta {
    margin-top: auto;
    padding-top: 1.25rem;
  }

  .tier-cta {
    display: block;
    text-align: center;
    background: var(--color-brand-primary);
    color: var(--color-brand-on-primary);
    border-radius: 999px;
    padding: 0.75rem 1.25rem;
    font-weight: 600;
    text-decoration: none;
  }

  .tier-cta:hover {
    filter: brightness(1.08);
  }

  .tier-app-only {
    margin-top: auto;
    padding-top: 1.25rem;
    color: var(--color-brand-text3);
    font-size: 0.875rem;
  }

  .tiers-footnote {
    color: var(--color-brand-text3);
    font-size: 0.8125rem;
    margin-top: 2rem;
    max-width: 46rem;
    line-height: 1.6;
  }
</style>
