---
import { Image } from 'astro:assets'
import reyesPortrait from '@assets/images/reyes.png'

// Marketing-only sample. The politician is fictional and the scores are
// illustrative. Real cards in the app pull from public voting records and
// each user's own weighted beliefs.
const POLITICIAN = {
  name: 'Senator Morgan Reyes',
  title: 'United States Senator',
  overallGrade: 'C',
  overallScore: 77,
}

const CATEGORIES = [
  { name: 'Economy and Work', grade: 'B' },
  { name: 'Justice and Public Safety', grade: 'C' },
  { name: 'Defense, Foreign Affairs, and Government', grade: 'B' },
  { name: 'Health, Education, and Family', grade: 'C' },
  { name: 'Environment and Technology', grade: 'D' },
  { name: 'Rights and Personal Liberty', grade: 'A' }
] as const

type Grade = 'A' | 'B' | 'C' | 'D' | 'F'

function gradeTone(grade: string): 'green' | 'yellow' | 'orange' | 'red' {
  const g = grade as Grade
  if (g === 'A' || g === 'B') return 'green'
  if (g === 'C') return 'yellow'
  if (g === 'D') return 'orange'
  return 'red'
}
---

<section class="sample" aria-labelledby="sample-heading">
  <div class="container">
    <header>
      <p class="eyebrow">What you'll see</p>
      <h2 id="sample-heading">Your representative, graded by your values.</h2>
      <p class="lead">
        Move sliders to codify what you care about. Voxivium grades every elected
        official on how their votes line up with your beliefs, overall and by area.
        Here's a sample report. The politician is fictional and the scores are
        illustrative.
      </p>
    </header>

    <div class="layout">
      <div class="phone" role="img" aria-label="Sample Voxivium report card for a fictional senator">
        <!-- Status bar -->
        <div class="phone-status">
          <span class="phone-time">9:41</span>
          <span class="phone-status-icons" aria-hidden="true">
            <svg viewBox="0 0 18 12" width="16" height="11">
              <path
                d="M1 8h2v3H1zM5 6h2v5H5zM9 4h2v7H9zM13 2h2v9h-2z"
                fill="currentColor"
              ></path>
            </svg>
            <svg viewBox="0 0 16 12" width="15" height="11">
              <path
                d="M8 11a1.5 1.5 0 100-3 1.5 1.5 0 000 3zM3.5 7.5a6.4 6.4 0 019 0l-1.1 1.1a4.8 4.8 0 00-6.8 0L3.5 7.5zM1 5a10 10 0 0114 0l-1.1 1.1a8.4 8.4 0 00-11.8 0L1 5z"
                fill="currentColor"
              ></path>
            </svg>
            <span class="phone-battery">
              <span class="phone-battery-fill"></span>
            </span>
          </span>
        </div>

        <!-- App header -->
        <div class="phone-header">
          <svg class="phone-icon" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
            <path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
          </svg>
          <span class="phone-logo">
            <img
              src="/press/voxivium-logo-dark.png"
              alt="Voxivium"
              width="64"
              height="22"
              class="phone-logo-img"
            />
          </span>
          <svg class="phone-icon" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
            <circle cx="12" cy="9" r="3.5" fill="currentColor"></circle>
            <path d="M5 20c1-3.5 4-5.5 7-5.5s6 2 7 5.5" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round"></path>
          </svg>
        </div>

        <!-- Politician profile -->
        <div class="phone-profile">
          <div class="phone-portrait">
            <Image
              src={reyesPortrait}
              alt=""
              width={260}
              height={260}
              densities={[1, 2]}
            />
          </div>
          <h3 class="phone-name">{POLITICIAN.name}</h3>
          <p class="phone-title">{POLITICIAN.title}</p>
          <div class="phone-grade-row">
            <span class:list={['grade-circle', `grade-${gradeTone(POLITICIAN.overallGrade)}`]}>
              {POLITICIAN.overallGrade}
            </span>
            <span class="phone-score">{POLITICIAN.overallScore}%</span>
          </div>
        </div>

        <!-- Performance Report -->
        <div class="phone-report">
          <h4 class="phone-report-title">Performance Report</h4>
          <p class="phone-cat-label">Category</p>
          <ul class="phone-cat-list">
            {
              CATEGORIES.map((cat) => (
                <li class="phone-cat-row">
                  <span class="phone-chevron" aria-hidden="true">
                    <svg viewBox="0 0 12 12" width="10" height="10">
                      <path d="M4 2l5 4-5 4z" fill="currentColor" />
                    </svg>
                  </span>
                  <span class="phone-cat-name">{cat.name}</span>
                  <span class:list={['grade-circle', 'grade-sm', `grade-${gradeTone(cat.grade)}`]}>
                    {cat.grade}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <div class="callouts">
        <article class="callout">
          <span class="callout-mark">1</span>
          <h3>One overall score</h3>
          <p>
            A single number that captures how often this politician's votes match
            your weighted beliefs, across every issue you care about.
          </p>
        </article>
        <article class="callout">
          <span class="callout-mark">2</span>
          <h3>Six category grades</h3>
          <p>
            Drill into the areas that matter most. Each grade reflects only the
            votes Voxivium can verify, scored against your specific positions.
          </p>
        </article>
        <article class="callout">
          <span class="callout-mark">3</span>
          <h3>Vote-by-vote receipts</h3>
          <p>
            Expand any category to see how the politician aligns with your individual beliefs, 
            and the evidence based on the issues they voted for or against.
          </p>
        </article>
      </div>
    </div>
  </div>
</section>

<style>
  .sample {
    padding: clamp(4rem, 10vh, 6rem) 1.5rem;
    background: color-mix(in oklab, var(--color-brand-surface), transparent 40%);
  }

  .container {
    max-width: 72rem;
    margin: 0 auto;
  }

  header {
    max-width: 48rem;
    margin: 0 auto 3rem;
    text-align: center;
  }

  .eyebrow {
    color: var(--color-brand-primary);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin: 0 0 0.75rem;
  }

  h2 {
    font-size: clamp(1.875rem, 3.5vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-brand-text1);
    margin: 0;
    line-height: 1.15;
    text-wrap: balance;
  }

  .lead {
    margin: 1.25rem auto 0;
    max-width: 42rem;
    color: var(--color-brand-text3);
    font-size: 1.0625rem;
    line-height: 1.6;
    text-wrap: balance;
  }

  .layout {
    display: grid;
    gap: 3rem;
    align-items: center;
    justify-items: center;
    grid-template-columns: 1fr;
  }

  @media (min-width: 880px) {
    .layout {
      grid-template-columns: minmax(280px, 360px) 1fr;
      gap: 4rem;
      justify-items: stretch;
    }
  }

  /* ----- Phone mockup ----------------------------------------------------- */
  /* The phone is always rendered in the app's dark theme regardless of the
     site theme, because that's what the app actually looks like. */
  .phone {
    --phone-bg: #0a1117;
    --phone-surface: #121e29;
    --phone-divider: #1f2f3d;
    --phone-text1: #f0f6fa;
    --phone-text2: #b5d1eb;
    --phone-text3: #7a93aa;
    --phone-accent: #6bb6e8;

    width: 100%;
    max-width: 340px;
    aspect-ratio: 9 / 19.5;
    background: var(--phone-bg);
    color: var(--phone-text1);
    border-radius: 1.75rem;
    overflow: hidden;
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.04) inset,
      0 30px 60px -20px rgba(0, 0, 0, 0.5),
      0 8px 24px -12px rgba(0, 0, 0, 0.35);
    border: 1px solid #1a2a38;
    font-family: 'Inter Variable', Inter, system-ui, sans-serif;
    display: flex;
    flex-direction: column;
    padding: 0.6rem 0.85rem 0.9rem;
    gap: 0.5rem;
  }

  .phone-status {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--phone-text1);
    padding: 0 0.25rem;
  }

  .phone-time {
    letter-spacing: 0.02em;
  }

  .phone-status-icons {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--phone-text2);
  }

  .phone-battery {
    display: inline-block;
    width: 18px;
    height: 9px;
    border: 1px solid currentColor;
    border-radius: 2px;
    position: relative;
    padding: 1px;
  }

  .phone-battery::after {
    content: '';
    position: absolute;
    right: -3px;
    top: 2px;
    width: 2px;
    height: 5px;
    background: currentColor;
    border-radius: 0 1px 1px 0;
  }

  .phone-battery-fill {
    display: block;
    width: 80%;
    height: 100%;
    background: var(--phone-text2);
    border-radius: 1px;
  }

  .phone-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.25rem 0.25rem 0.4rem;
    color: var(--phone-text1);
  }

  .phone-icon {
    color: var(--phone-text2);
  }

  .phone-logo {
    display: inline-flex;
    align-items: center;
  }

  .phone-logo-img {
    display: block;
    height: 22px;
    width: auto;
  }

  .phone-profile {
    text-align: center;
    padding: 0.5rem 0 0.4rem;
  }

  .phone-portrait {
    width: 7rem;
    height: 7rem;
    margin: 0 auto 0.75rem;
    border-radius: 0.6rem;
    overflow: hidden;
    background: var(--phone-surface);
  }

  .phone-portrait :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Source has more headroom than chin-space; nudge up so the face sits
       in the visual center of the square crop. */
    object-position: center 30%;
  }

  .phone-name {
    margin: 0;
    font-size: 1rem;
    font-weight: 700;
    color: var(--phone-text1);
    line-height: 1.2;
  }

  .phone-title {
    margin: 0.15rem 0 0;
    font-size: 0.78rem;
    color: var(--phone-text3);
  }

  .phone-grade-row {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.65rem;
  }

  .phone-score {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--phone-text1);
  }

  .phone-report {
    margin-top: 0.4rem;
    padding-top: 0.6rem;
    border-top: 1px solid var(--phone-divider);
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
  }

  .phone-report-title {
    margin: 0;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--phone-text1);
  }

  .phone-cat-label {
    margin: 0.6rem 0 0.3rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--phone-accent);
  }

  .phone-cat-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .phone-cat-row {
    display: grid;
    grid-template-columns: 0.85rem 1fr 1.4rem;
    align-items: center;
    gap: 0.55rem;
    padding: 0.5rem 0;
    border-top: 1px solid var(--phone-divider);
    font-size: 0.72rem;
    line-height: 1.25;
    color: var(--phone-text1);
  }

  .phone-cat-row:first-child {
    border-top: none;
    padding-top: 0.35rem;
  }

  .phone-chevron {
    color: var(--phone-text3);
    display: inline-flex;
  }

  .phone-cat-name {
    color: var(--phone-text1);
  }

  /* ----- Grade circles (shared between overall + category) ---------------- */
  .grade-circle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.65rem;
    height: 1.65rem;
    border-radius: 50%;
    font-weight: 800;
    font-size: 0.8rem;
    color: #0a1117;
    font-family: 'Inter Variable', Inter, system-ui, sans-serif;
  }

  .grade-circle.grade-sm {
    width: 1.25rem;
    height: 1.25rem;
    font-size: 0.7rem;
  }

  .grade-green {
    background: #7fcb86;
  }
  .grade-yellow {
    background: #f5c460;
  }
  .grade-orange {
    background: #f49a52;
  }
  .grade-red {
    background: #e26464;
  }

  /* ----- Callouts beside the phone --------------------------------------- */
  .callouts {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 32rem;
  }

  .callout {
    position: relative;
    padding-left: 3rem;
  }

  .callout-mark {
    position: absolute;
    left: 0;
    top: 0;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: color-mix(in oklab, var(--color-brand-primary), transparent 80%);
    color: var(--color-brand-primary);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.9rem;
  }

  .callout h3 {
    margin: 0.15rem 0 0.35rem;
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-brand-text1);
  }

  .callout p {
    margin: 0;
    color: var(--color-brand-text3);
    font-size: 0.95rem;
    line-height: 1.55;
  }
</style>
