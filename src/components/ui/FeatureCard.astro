---
interface Props {
  title: string
}

const { title } = Astro.props
---

<article class="feature-card">
  <h3>{title}</h3>
  <div class="body">
    <slot />
  </div>
</article>

<style>
  /* Surface styling per KMP STYLE_GUIDE §1 (24px corners) + §2 (subtle gradient
     surface, diffuse low-alpha shadow). The gradient shifts ~5% from top-left to
     bottom-right rather than a flat fill; the shadow is high-blur + low-alpha
     so the card reads as floating without a hard outline. */
  .feature-card {
    background:
      linear-gradient(
        135deg,
        color-mix(in oklab, var(--color-brand-surface), white 4%) 0%,
        var(--color-brand-surface) 60%,
        color-mix(in oklab, var(--color-brand-surface), black 3%) 100%
      );
    border: 1px solid color-mix(in oklab, var(--color-brand-text1), transparent 88%);
    border-radius: 1.5rem;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    height: 100%;
    box-shadow: 0 24px 48px -32px rgba(0, 0, 0, 0.05);
  }

  :global(html.dark) .feature-card {
    background:
      linear-gradient(
        135deg,
        color-mix(in oklab, var(--color-brand-surface), white 5%) 0%,
        var(--color-brand-surface) 60%,
        color-mix(in oklab, var(--color-brand-surface), black 8%) 100%
      );
    border-color: color-mix(in oklab, var(--color-brand-text1), transparent 82%);
    box-shadow: 0 24px 48px -32px rgba(0, 0, 0, 0.4);
  }

  .feature-card h3 {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-brand-text1);
    margin: 0;
    letter-spacing: -0.01em;
  }

  .feature-card .body {
    color: var(--color-brand-text3);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .feature-card .body :global(p) {
    margin: 0;
  }
</style>
